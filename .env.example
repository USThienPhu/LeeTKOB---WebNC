NODE_ENV=development
PORT=3000
DATABASE_URL=sqlite://./leetkob.db
SANDBOX_DOCKER_IMAGE=leetkob-sandbox:latest
# Docker socket group ID (use the host socket GID on Linux).
DOCKER_GID=0
# Spending cap configured in LLM Provider Console
MODEL_PROVIDER=gemini
MODEL_API_KEY=your_gemini_api_key_here
MODEL_SPENDING_CAP_USD=5.00
